# =============================================================================
# EIMS API — Environment Variables
# Copy to apps/api/.env and fill in values for your deployment
# =============================================================================

# Server
NODE_ENV=development
PORT=3001

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Institution (white-label — change per deployment)
INSTITUTION_NAME="Your Institution Name"
INSTITUTION_TYPE="coaching"
INSTITUTION_TIMEZONE="Asia/Karachi"

# App URLs (for CORS and email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_URL="http://localhost:3001"

# Payment gateway (Wave 2)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Biometric punch webhook (Phase 7 — deferred)
# When set, devices must send header X-Biometric-Webhook-Secret
BIOMETRIC_WEBHOOK_SECRET=

# Push notifications (token store ready; send stub until FCM/Expo push wired)
# FCM_SERVER_KEY=

# Transport GPS webhook
# TRANSPORT_GPS_WEBHOOK_SECRET=

# JWT (optional — if verifying Supabase JWT locally)
JWT_SECRET="your-jwt-secret-from-supabase-settings"

# Email (Phase 2 — transactional emails)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="noreply@institution.pk"

# SMS / WhatsApp — Twilio (institution keys; Nexium does not pay Meta)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_CONTENT_SID_NOTICE=
# TWILIO_WHATSAPP_CONTENT_SID_FEE=
# TWILIO_WHATSAPP_CONTENT_SID_ABSENCE=
# TWILIO_WHATSAPP_CONTENT_SID_RESULT=
# TWILIO_WHATSAPP_CONTENT_SID_CUSTOM=
# TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/v1/webhooks/twilio/status

# Seed config path (used by db:seed script)
# SEED_CONFIG_PATH="docs/templates/institution-seed.example.json"
