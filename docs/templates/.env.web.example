# =============================================================================
# EIMS Web — Environment Variables
# Copy to apps/web/.env.local and fill in values for your deployment
# =============================================================================

# Supabase (public keys — safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# App URL (canonical URL for this deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Institution (fallback before DB settings load — change per deployment)
INSTITUTION_NAME="Your Institution Name"

# NEVER put these in the web app:
# SUPABASE_SERVICE_ROLE_KEY
# DATABASE_URL
