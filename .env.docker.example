# =============================================================================
# EIMS Docker / VPS — copy to repo root as `.env` before `docker compose up`
# Domain: nexium-eims.online
# =============================================================================

# Let's Encrypt contact (Caddy)
ACME_EMAIL=admin@nexium-eims.online

# Public URLs (must match DNS + Caddyfile)
NEXT_PUBLIC_APP_URL=https://nexium-eims.online
WEB_URL=https://nexium-eims.online
NEXT_PUBLIC_API_URL=https://api.nexium-eims.online

# Institution
INSTITUTION_NAME=Nexium Academy
INSTITUTION_TYPE=coaching
INSTITUTION_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_SKIP_ADMIN_MFA=0

# Supabase (same project for web + api)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Supabase pooler)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Email (optional but needed for invites)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nexium Academy <noreply@nexium-eims.online>

# Optional integrations
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
