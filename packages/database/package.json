{
  "name": "@eims/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "npx dotenv-cli -e ../../apps/api/.env -- npx prisma db push",
    "db:migrate": "npx dotenv-cli -e ../../apps/api/.env -- npx prisma migrate dev",
    "db:migrate:deploy": "npx dotenv-cli -e ../../apps/api/.env -- npx prisma migrate deploy",
    "db:seed": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/seed.ts",
    "db:seed:demo": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/seed-demo-cli.ts",
    "db:seed:auth": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/seed-auth.ts",
    "db:seed:all": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/seed.ts && npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/seed-auth.ts",
    "db:seed:verify": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/verify-demo-seed.ts",
    "db:import:shahwali": "npx dotenv-cli -e ../../apps/api/.env -- npx tsx prisma/import-shahwali-fee-register.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@eims/shared": "*",
    "@prisma/client": "^6.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "turbo": "^2.10.9",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
