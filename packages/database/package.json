{
  "name": "@eims/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e ../../apps/api/.env -- prisma db push",
    "db:migrate": "dotenv -e ../../apps/api/.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../apps/api/.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../apps/api/.env -- tsx prisma/seed.ts",
    "db:seed:demo": "dotenv -e ../../apps/api/.env -- tsx prisma/seed-demo-cli.ts",
    "db:seed:auth": "dotenv -e ../../apps/api/.env -- tsx prisma/seed-auth.ts",
    "db:seed:all": "dotenv -e ../../apps/api/.env -- tsx prisma/seed.ts && dotenv -e ../../apps/api/.env -- tsx prisma/seed-auth.ts",
    "db:seed:verify": "dotenv -e ../../apps/api/.env -- tsx prisma/verify-demo-seed.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@eims/shared": "*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
