generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model InstitutionSettings {
  id              String   @id @default("default")
  name            String
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#2563eb")
  address         String?
  city            String?
  province        String?
  country         String   @default("Pakistan")
  phone           String?
  email           String?
  website         String?
  timezone        String   @default("Asia/Karachi")
  currency        String   @default("PKR")
  institutionType String   @default("coaching")
  terminology     Json     @default("{}")
  featureFlags    Json     @default("{}")
  siblingDiscountPercent Decimal? @db.Decimal(5, 2)
  lateFeeAmount          Decimal? @db.Decimal(12, 2)
  lateFeeDaysAfterDue    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users    User[]
  students Student[]
  programs Program[]
}

model User {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  email          String    @unique
  fullName       String
  phone          String?
  branchId       String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branch      Branch?       @relation(fields: [branchId], references: [id])
  userRoles   UserRole[]
  userSessions UserSession[]

  @@index([branchId])
  @@index([supabaseUserId])
  @@index([branchId, deletedAt, isActive])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  module    String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model LookupCategory {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  statuses LookupStatus[]
}

model LookupStatus {
  id         String  @id @default(cuid())
  categoryId String
  code       String
  label      String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  category LookupCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
}

model Program {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  code        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  batches  Batch[]
  students Student[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, deletedAt])
}

model Batch {
  id           String    @id @default(cuid())
  branchId     String
  programId    String
  name         String
  code         String?
  sessionId    String?
  scheduleType String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  program        Program         @relation(fields: [programId], references: [id])
  students       Student[]
  batchSubjects  BatchSubject[]

  @@index([branchId])
  @@index([programId])
  @@index([branchId, deletedAt])
}

model Subject {
  id        String    @id @default(cuid())
  name      String
  code      String?   @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batchSubjects   BatchSubject[]
  studentSubjects StudentSubject[]
}

model BatchSubject {
  id        String @id @default(cuid())
  batchId   String
  subjectId String

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
  @@index([batchId])
}

model StudentSubject {
  id        String @id @default(cuid())
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([studentId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            String    @id @default(cuid())
  branchId      String
  fullName      String
  dateOfBirth   DateTime?
  gender        String?
  cnicOrBForm   String?
  phone         String?
  email         String?
  address       String?
  photographUrl String?
  programId     String?
  batchId       String?
  statusId      String
  customFields  Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?

  branch            Branch             @relation(fields: [branchId], references: [id])
  program           Program?           @relation(fields: [programId], references: [id])
  batch             Batch?             @relation(fields: [batchId], references: [id])
  studentParents    StudentParent[]
  studentSubjects   StudentSubject[]
  assessmentRecords AssessmentRecord[]
  feeInvoices       FeeInvoice[]
  documents         Document[]

  @@index([branchId])
  @@index([batchId])
  @@index([statusId])
  @@index([branchId, deletedAt])
  @@index([branchId, batchId, deletedAt])
}

model Parent {
  id        String    @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  address   String?
  cnic      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  studentParents StudentParent[]

  @@index([deletedAt])
}

model StudentParent {
  id               String @id @default(cuid())
  studentId        String
  parentId         String
  relationshipCode String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
}

model AssessmentType {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AssessmentSeries {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assessments Assessment[]
}

model Assessment {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  typeId      String
  seriesId    String?
  sessionId   String?
  totalMarks  Decimal   @db.Decimal(10, 2)
  conductedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  series  AssessmentSeries?  @relation(fields: [seriesId], references: [id])
  records AssessmentRecord[]

  @@index([branchId])
  @@index([branchId, conductedAt])
}

model AssessmentRecord {
  id            String   @id @default(cuid())
  assessmentId  String
  studentId     String
  subjectId     String
  obtainedMarks Decimal? @db.Decimal(10, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  grade         String?
  rank          Int?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId, subjectId])
  @@index([studentId])
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  branchId   String
  entityType String
  entityId   String
  date       DateTime @db.Date
  statusId   String
  remarks    String?
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, date])
  @@index([branchId])
  @@index([date])
  @@index([entityType, entityId])
  @@index([branchId, entityType, date])
  @@index([branchId, entityType, date, statusId])
}

model FeeType {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  feeStructures FeeStructure[]
}

model FeeStructure {
  id            String   @id @default(cuid())
  branchId      String
  feeTypeId     String
  programId     String?
  batchId       String?
  amount        Decimal  @db.Decimal(12, 2)
  dueDayOfMonth Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  @@index([branchId])
  @@index([batchId])
  @@index([programId])
  @@index([feeTypeId])
}

model FeeInvoice {
  id          String    @id @default(cuid())
  branchId    String
  studentId   String
  feeTypeId   String
  amount      Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  fine        Decimal   @default(0) @db.Decimal(12, 2)
  netAmount   Decimal   @db.Decimal(12, 2)
  dueDate     DateTime?
  paidAt      DateTime?
  statusId    String
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([studentId])
  @@index([statusId])
  @@index([branchId, paidAt])
  @@index([branchId, dueDate])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  roleId      String
  branchId    String?
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  supabaseSessionId String?
  deviceInfo        String?
  ipAddress         String?
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastActiveAt])
}

model Notice {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  body        String
  audience    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([branchId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  branchId  String
  batchId   String
  subjectId String
  teacherId String?
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([batchId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

model FormField {
  id         String   @id @default(cuid())
  code       String   @unique
  label      String
  fieldType  String
  options    Json?
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Document {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String?
  category     String
  title        String
  storagePath  String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([branchId])
  @@index([category])
  @@index([branchId, deletedAt])
}

model AttendanceOcrSession {
  id          String    @id @default(cuid())
  branchId    String
  batchId     String
  date        DateTime  @db.Date
  imagePath   String
  rawText     String?
  status      String    @default("pending")
  suggestions Json      @default("[]")
  createdById String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([branchId])
  @@index([batchId])
  @@index([status])
}

model CommunicationLog {
  id          String   @id @default(cuid())
  channel     String
  recipient   String
  subject     String?
  body        String
  status      String   @default("queued")
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([channel])
  @@index([createdAt])
}
