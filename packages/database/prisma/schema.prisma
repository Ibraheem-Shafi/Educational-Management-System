  status               String    @default("open")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  account Account?            @relation(fields: [accountId], references: [id])
  lines   BankStatementLine[]

  @@unique([branchId, year, month, chequeBookNo])
  @@index([branchId, deletedAt])
  @@index([branchId, year, month])
  @@index([accountId])
}

model BankStatementLine {
  id                   String    @id @default(cuid())
  statementId          String
  issueDate            DateTime  @db.Date
  chequeNumber         String
  payee                String
  onAccountOf          String
  amount               Decimal   @db.Decimal(14, 2)
  useInCampus          String?
  clearingDate         DateTime? @db.Date
  matchedJournalLineId String?
  matchedFeePaymentId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  statement          BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedJournalLine JournalLine?  @relation(fields: [matchedJournalLineId], references: [id])
  matchedFeePayment  FeePayment?   @relation(fields: [matchedFeePaymentId], references: [id])

  @@index([statementId])
  @@index([chequeNumber])
  @@index([matchedJournalLineId])
  @@index([matchedFeePaymentId])
}

model OwnerDrawing {
  id               String    @id @default(cuid())
  branchId         String
  drawingDate      DateTime  @db.Date
  payee            String
  amount           Decimal   @db.Decimal(14, 2)
  method           String
  chequeNumber     String?
  notes            String?
  journalVoucherId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([branchId, deletedAt])
  @@index([drawingDate])
}

model PurchaseOrder {
  id        String    @id @default(cuid())
  branchId  String
  vendorId  String
  poNo      String
  orderDate DateTime  @db.Date
  status    String    @default("draft")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vendor     Vendor           @relation(fields: [vendorId], references: [id])
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]
  vendorBills VendorBill[]

  @@unique([branchId, poNo])
  @@index([branchId, deletedAt])
  @@index([vendorId])
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Decimal @db.Decimal(12, 2)
  unitCost        Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String
  receivedAt      DateTime @db.Date
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model FixedAsset {
  id              String    @id @default(cuid())
  branchId        String
  name            String
  /// furniture | chairs | equipment | electronics | other
  category        String
  /// school (campus-wide) | class
  scope           String    @default("school")
  quantity        Int       @default(1)
  batchId         String?
  purchaseDate    DateTime? @db.Date
  cost            Decimal   @db.Decimal(14, 2)
  vendorBillId    String?
  purchaseOrderId String?
  status          String    @default("active")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  vendorBill VendorBill? @relation(fields: [vendorBillId], references: [id])
  batch      Batch?      @relation(fields: [batchId], references: [id])

  @@index([branchId, deletedAt])
  @@index([vendorBillId])
  @@index([status])
  @@index([scope])
  @@index([batchId])
}

model BudgetForecastLine {
  id        String  @id @default(cuid())
  budgetId  String
  month     Int
  amount    Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, month])
  @@index([budgetId])
}

// --- HR lifecycle + campus ops ---

model Applicant {
  id           String    @id @default(cuid())
  branchId     String
  fullName     String
  email        String?
  phone        String?
  roleApplied  String
  stage        String    @default("applied")
  appliedAt    DateTime  @db.Date
  hiredUserId  String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  hiredUser User? @relation(fields: [hiredUserId], references: [id])

  @@index([branchId, deletedAt])
  @@index([stage])
}

model WorkOrder {
  id           String    @id @default(cuid())
  branchId     String
  location     String
  issue        String
  status       String    @default("open")
  cost         Decimal?  @db.Decimal(14, 2)
  vendorBillId String?
  reportedAt   DateTime  @db.Date
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  vendorBill VendorBill? @relation(fields: [vendorBillId], references: [id])

  @@index([branchId, deletedAt])
  @@index([status])
}

model SafetyIncident {
  id           String    @id @default(cuid())
  branchId     String
  incidentDate DateTime  @db.Date
  severity     String
  summary      String
  action       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId, deletedAt])
  @@index([incidentDate])
}

model ItOutage {
  id        String    @id @default(cuid())
  branchId  String
  startedAt DateTime
  endedAt   DateTime?
  system    String
  summary   String
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId, deletedAt])
  @@index([startedAt])
}

model ComplianceControl {
  id                 String    @id @default(cuid())
  branchId           String
  title              String
  category           String
  dueDate            DateTime? @db.Date
  status             String    @default("open")
  evidenceDocumentId String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([branchId, deletedAt])
  @@index([status])
}
