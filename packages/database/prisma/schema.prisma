generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model InstitutionSettings {
  id              String   @id @default("default")
  name            String
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#2563eb")
  address         String?
  city            String?
  province        String?
  country         String   @default("Pakistan")
  phone           String?
  email           String?
  website         String?
  timezone        String   @default("Asia/Karachi")
  currency        String   @default("PKR")
  institutionType String   @default("coaching")
  terminology     Json     @default("{}")
  featureFlags    Json     @default("{}")
  siblingDiscountPercent Decimal? @db.Decimal(5, 2)
  lateFeeAmount          Decimal? @db.Decimal(12, 2)
  lateFeeDaysAfterDue    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users    User[]
  students Student[]
  programs Program[]
}

model User {
  id             String    @id @default(cuid())
  supabaseUserId String    @unique
  email          String    @unique
  fullName       String
  phone          String?
  gender         String?
  cnic           String?
  branchId       String?
  department     String?
  designation    String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branch               Branch?              @relation(fields: [branchId], references: [id])
  userRoles            UserRole[]
  userSessions         UserSession[]
  employmentContracts  EmploymentContract[]
  performanceReviews   PerformanceReview[]  @relation("ReviewSubject")
  reviewsAuthored       PerformanceReview[]  @relation("ReviewAuthor")
  documents             Document[]
  libraryLoansBorrowed       LibraryLoan[]                @relation("LibraryLoanBorrower")
  libraryLoansIssued         LibraryLoan[]                @relation("LibraryLoanIssuer")
  libraryReservations        LibraryReservation[]         @relation("LibraryReservationBorrower")
  transportStaffAssignments  TransportStaffAssignment[]
  salaryStructures           SalaryStructure[]
  payrollLines               PayrollLine[]
  devicePushTokens           DevicePushToken[]
  leaveRequests              LeaveRequest[]

  @@index([branchId])
  @@index([supabaseUserId])
  @@index([branchId, deletedAt, isActive])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  module    String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model LookupCategory {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  statuses LookupStatus[]
}

model LookupStatus {
  id         String  @id @default(cuid())
  categoryId String
  code       String
  label      String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  category LookupCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
}

model Program {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  code        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch   Branch    @relation(fields: [branchId], references: [id])
  batches  Batch[]
  students Student[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, deletedAt])
}

model Batch {
  id           String    @id @default(cuid())
  branchId     String
  programId    String
  name         String
  code         String?
  sessionId    String?
  scheduleType String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  program        Program         @relation(fields: [programId], references: [id])
  students       Student[]
  batchSubjects  BatchSubject[]

  @@index([branchId])
  @@index([programId])
  @@index([branchId, deletedAt])
}

model Subject {
  id        String    @id @default(cuid())
  name      String
  code      String?   @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  batchSubjects   BatchSubject[]
  studentSubjects StudentSubject[]
}

model BatchSubject {
  id        String @id @default(cuid())
  batchId   String
  subjectId String

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
  @@index([batchId])
}

model StudentSubject {
  id        String @id @default(cuid())
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([studentId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id               String    @id @default(cuid())
  branchId         String
  fullName         String
  dateOfBirth      DateTime?
  gender           String?
  cnicOrBForm      String?
  phone            String?
  email            String?
  address          String?
  photographUrl    String?
  programId        String?
  batchId          String?
  statusId         String
  admissionNumber  String?
  rollNumber       String?
  customFields     Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdById      String?

  branch            Branch             @relation(fields: [branchId], references: [id])
  program           Program?           @relation(fields: [programId], references: [id])
  batch             Batch?             @relation(fields: [batchId], references: [id])
  studentParents    StudentParent[]
  studentSubjects   StudentSubject[]
  assessmentRecords AssessmentRecord[]
  feeInvoices       FeeInvoice[]
  documents            Document[]
  leaveRequests        LeaveRequest[]
  certificateIssues    CertificateIssue[]
  libraryLoans         LibraryLoan[]
  libraryReservations  LibraryReservation[]
  transportAssignments StudentTransport[]
  transportAttendance  TransportAttendance[]

  @@unique([branchId, admissionNumber])
  @@unique([branchId, batchId, rollNumber])
  @@index([branchId])
  @@index([batchId])
  @@index([statusId])
  @@index([branchId, deletedAt])
  @@index([branchId, batchId, deletedAt])
  @@index([branchId, rollNumber])
  @@index([branchId, admissionNumber])
}

model Parent {
  id        String    @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  address   String?
  cnic      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  studentParents StudentParent[]
  leaveRequests  LeaveRequest[]

  @@index([deletedAt])
}

model StudentParent {
  id               String @id @default(cuid())
  studentId        String
  parentId         String
  relationshipCode String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
}

model AssessmentType {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AssessmentSeries {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assessments Assessment[]
}

model Assessment {
  id            String    @id @default(cuid())
  branchId      String
  name          String
  typeId        String
  seriesId      String?
  sessionId     String?
  totalMarks    Decimal   @db.Decimal(10, 2)
  conductedAt   DateTime?
  status        String    @default("draft")
  publishedAt   DateTime?
  publishedById String?
  answerKey     String?
  reviewNotes   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  series  AssessmentSeries?  @relation(fields: [seriesId], references: [id])
  records AssessmentRecord[]

  @@index([branchId])
  @@index([branchId, conductedAt])
  @@index([branchId, status])
}

model AssessmentRecord {
  id            String   @id @default(cuid())
  assessmentId  String
  studentId     String
  subjectId     String
  obtainedMarks Decimal? @db.Decimal(10, 2)
  percentage    Decimal? @db.Decimal(5, 2)
  grade         String?
  rank          Int?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId, subjectId])
  @@index([studentId])
}

model AttendanceRecord {
  id         String   @id @default(cuid())
  branchId   String
  entityType String
  entityId   String
  date       DateTime @db.Date
  statusId   String
  remarks    String?
  markedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, date])
  @@index([branchId])
  @@index([date])
  @@index([entityType, entityId])
  @@index([branchId, entityType, date])
  @@index([branchId, entityType, date, statusId])
}

model FeeType {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  feeStructures FeeStructure[]
  vouchers      JournalVoucher[]
}

model FeeStructure {
  id            String   @id @default(cuid())
  branchId      String
  feeTypeId     String
  programId     String?
  batchId       String?
  amount        Decimal  @db.Decimal(12, 2)
  dueDayOfMonth Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feeType FeeType @relation(fields: [feeTypeId], references: [id])

  @@index([branchId])
  @@index([batchId])
  @@index([programId])
  @@index([feeTypeId])
}

model FeeInvoice {
  id          String    @id @default(cuid())
  branchId    String
  studentId   String
  feeTypeId   String
  invoiceNo   String?
  amount      Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  fine        Decimal   @default(0) @db.Decimal(12, 2)
  netAmount   Decimal   @db.Decimal(12, 2)
  dueDate     DateTime?
  paidAt      DateTime?
  statusId    String
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments FeePayment[]

  @@unique([branchId, invoiceNo])
  @@index([branchId])
  @@index([studentId])
  @@index([statusId])
  @@index([branchId, paidAt])
  @@index([branchId, dueDate])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  roleId      String
  branchId    String?
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  supabaseSessionId String?
  deviceInfo        String?
  ipAddress         String?
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastActiveAt])
}

model Notice {
  id          String    @id @default(cuid())
  branchId    String
  title       String
  body        String
  audience    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([branchId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  branchId  String
  batchId   String
  subjectId String
  teacherId String?
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([batchId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

model FormField {
  id         String   @id @default(cuid())
  code       String   @unique
  label      String
  fieldType  String
  options    Json?
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Document {
  id           String    @id @default(cuid())
  branchId     String
  studentId    String?
  userId       String?
  category     String
  title        String
  storagePath  String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([userId])
  @@index([branchId])
  @@index([category])
  @@index([branchId, deletedAt])
}

model AttendanceOcrSession {
  id          String    @id @default(cuid())
  branchId    String
  batchId     String
  date        DateTime  @db.Date
  imagePath   String
  rawText     String?
  status      String    @default("pending")
  suggestions Json      @default("[]")
  createdById String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([branchId])
  @@index([batchId])
  @@index([status])
}

model CommunicationLog {
  id          String   @id @default(cuid())
  channel     String
  recipient   String
  subject     String?
  body        String
  status      String   @default("queued")
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([channel])
  @@index([createdAt])
}

model LearningResource {
  id               String    @id @default(cuid())
  branchId         String
  type             String
  title            String
  description      String?
  body             String?
  programId        String?
  batchId          String?
  subjectId        String?
  visibilityScope  String
  audience         String    @default("all")
  dueAt            DateTime?
  maxMarks         Decimal?  @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  meetingUrl       String?
  meetingPlatform  String?
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  attachments LearningAttachment[]

  @@index([branchId, type, deletedAt])
  @@index([batchId])
  @@index([subjectId])
  @@index([dueAt])
  @@index([startsAt])
  @@index([isPublished, deletedAt])
}

model LearningAttachment {
  id           String   @id @default(cuid())
  resourceId   String
  fileName     String
  storagePath  String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())

  resource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  /** student = parent-submitted student absence; employee = staff leave */
  kind         String   @default("student")
  studentId    String?
  parentId     String?
  userId       String?
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  reason       String
  status       String   @default("pending")
  reviewedById String?
  attachmentFileName    String?
  attachmentStoragePath String?
  attachmentMimeType    String?
  attachmentSizeBytes   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent?  @relation(fields: [parentId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([parentId])
  @@index([userId])
  @@index([kind, status])
  @@index([status])
}

// --- Phase 4: Front office ---

model AdmissionInquiry {
  id                  String    @id @default(cuid())
  branchId            String
  fullName            String
  phone               String?
  email               String?
  programInterest     String?
  status              String    @default("new")
  notes               String?
  followUpAt          DateTime?
  convertedStudentId  String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([branchId, deletedAt])
  @@index([branchId, status])
  @@index([convertedStudentId])
}

model Visitor {
  id           String    @id @default(cuid())
  branchId     String
  fullName     String
  phone        String?
  purpose      String?
  hostName     String?
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([branchId, deletedAt])
  @@index([branchId, checkedInAt])
}

model ComplaintRequest {
  id            String    @id @default(cuid())
  branchId      String
  type          String
  subject       String
  body          String
  status        String    @default("open")
  priority      String    @default("normal")
  requesterName String?
  requesterPhone String?
  assignedToId  String?
  resolvedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([branchId, deletedAt])
  @@index([branchId, status])
  @@index([type])
}

model ReceptionActivity {
  id          String   @id @default(cuid())
  branchId    String
  action      String
  entityType  String?
  entityId    String?
  summary     String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([branchId, createdAt])
}

// --- Phase 4: Expanded HR ---

model EmploymentContract {
  id             String    @id @default(cuid())
  userId         String
  branchId       String
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  employmentType String
  salaryNote     String?
  status         String    @default("active")
  documentPath   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([branchId, deletedAt])
}

model PerformanceReview {
  id           String   @id @default(cuid())
  userId       String
  branchId     String
  periodLabel  String
  reviewedAt   DateTime @db.Date
  score        Decimal? @db.Decimal(5, 2)
  summary      String
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user       User  @relation("ReviewSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewAuthor", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([branchId, deletedAt])
}

// --- Print document templates (fee vouchers, roll slips, etc.) ---

model PrintDocumentTemplate {
  id          String   @id @default(cuid())
  branchId    String?
  type        String
  name        String
  paperSize   String   @default("a4")
  fields      Json?
  headerText  String?
  footerText  String?
  extraNote   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
  @@index([branchId])
  @@index([type, branchId])
}

// --- Phase 4: Certificates ---

model CertificateTemplate {
  id        String   @id @default(cuid())
  branchId  String?
  type      String
  name      String
  fields    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues CertificateIssue[]

  @@index([type, isActive])
  @@index([branchId])
}

model CertificateIssue {
  id         String    @id @default(cuid())
  branchId   String
  studentId  String
  templateId String
  title      String
  serialNo   String?
  issuedAt   DateTime  @default(now())
  issuedById String?
  meta       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  template CertificateTemplate @relation(fields: [templateId], references: [id])
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([branchId, deletedAt])
  @@index([studentId])
  @@index([templateId])
}

// --- Phase 5: Library ---

model LibraryCategory {
  id        String    @id @default(cuid())
  branchId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  books LibraryBook[]

  @@index([branchId, deletedAt])
}

model LibraryBook {
  id          String    @id @default(cuid())
  branchId    String
  categoryId  String?
  title       String
  author      String
  publisher   String?
  edition     String?
  isbn        String?
  accessionNo String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category     LibraryCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  copies       LibraryCopy[]
  reservations LibraryReservation[]

  @@index([branchId, deletedAt])
  @@index([branchId, accessionNo])
  @@index([categoryId])
}

model LibraryCopy {
  id        String    @id @default(cuid())
  bookId    String
  copyCode  String
  status    String    @default("available")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  book  LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans LibraryLoan[]

  @@unique([bookId, copyCode])
  @@index([bookId, deletedAt])
  @@index([status])
}

model LibraryLoan {
  id           String    @id @default(cuid())
  copyId       String
  borrowerType String
  studentId    String?
  userId       String?
  issuedAt     DateTime  @default(now())
  dueAt        DateTime
  returnedAt   DateTime?
  renewedCount Int       @default(0)
  issuedById   String?
  branchId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  copy     LibraryCopy   @relation(fields: [copyId], references: [id])
  student  Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  user     User?         @relation("LibraryLoanBorrower", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User?         @relation("LibraryLoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  fines    LibraryFine[]

  @@index([branchId])
  @@index([copyId])
  @@index([studentId])
  @@index([userId])
  @@index([returnedAt])
}

model LibraryReservation {
  id           String    @id @default(cuid())
  bookId       String
  borrowerType String
  studentId    String?
  userId       String?
  status       String    @default("active")
  reservedAt   DateTime  @default(now())
  branchId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  book    LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  user    User?       @relation("LibraryReservationBorrower", fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId, deletedAt])
  @@index([bookId, status])
  @@index([studentId])
  @@index([userId])
}

model LibraryFine {
  id        String   @id @default(cuid())
  loanId    String
  branchId  String
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("unpaid")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan LibraryLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([loanId])
}

// --- Phase 5: Transport ---

model TransportVehicle {
  id          String    @id @default(cuid())
  branchId    String
  plateNumber String
  makeModel   String?
  capacity    Int?
  status      String    @default("active")
  gpsDeviceId String?
  lastLat     Decimal?  @db.Decimal(10, 7)
  lastLng     Decimal?  @db.Decimal(10, 7)
  lastPingAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  staffAssignments TransportStaffAssignment[]
  trips            TransportTrip[]
  documents        TransportVehicleDocument[]

  @@unique([branchId, plateNumber])
  @@index([branchId, deletedAt])
  @@index([gpsDeviceId])
}

model TransportStaffAssignment {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, userId, role])
  @@index([vehicleId])
  @@index([userId])
}

model TransportRoute {
  id        String    @id @default(cuid())
  branchId  String
  name      String
  code      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stops       TransportStop[]
  assignments StudentTransport[]
  trips       TransportTrip[]

  @@index([branchId, deletedAt])
}

model TransportStop {
  id          String   @id @default(cuid())
  routeId     String
  name        String
  sequence    Int
  pickupTime  String?
  dropoffTime String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route       TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments StudentTransport[]

  @@unique([routeId, sequence])
  @@index([routeId])
}

model StudentTransport {
  id        String    @id @default(cuid())
  studentId String
  routeId   String
  stopId    String
  direction String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    TransportStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([studentId, deletedAt])
  @@index([routeId, deletedAt])
  @@index([stopId])
}

model TransportTrip {
  id        String   @id @default(cuid())
  routeId   String
  vehicleId String?
  tripDate  DateTime @db.Date
  direction String
  status    String   @default("scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route      TransportRoute        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle    TransportVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  attendance TransportAttendance[]

  @@index([routeId, tripDate])
  @@index([vehicleId])
  @@index([status])
}

model TransportAttendance {
  id         String   @id @default(cuid())
  tripId     String
  studentId  String
  status     String
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip    TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tripId, studentId])
  @@index([tripId])
  @@index([studentId])
}

model TransportVehicleDocument {
  id          String   @id @default(cuid())
  vehicleId   String
  title       String
  storagePath String
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// --- Phase 6: Payroll ---

model SalaryStructure {
  id           String    @id @default(cuid())
  userId       String
  branchId     String
  basicSalary  Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime @db.Date
  effectiveTo  DateTime? @db.Date
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@index([userId, deletedAt])
  @@index([branchId, deletedAt])
  @@index([userId, isActive])
}

model SalaryComponent {
  id             String   @id @default(cuid())
  structureId    String
  kind           String
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  percentOfBasic Decimal? @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model PayrollRun {
  id           String    @id @default(cuid())
  branchId     String
  year         Int
  month        Int
  status       String    @default("draft")
  approvedById String?
  finalizedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PayrollLine[]

  @@unique([branchId, year, month])
  @@index([branchId, status])
}

model PayrollLine {
  id                   String   @id @default(cuid())
  runId                String
  userId               String
  basicSalary          Decimal  @db.Decimal(12, 2)
  allowancesTotal      Decimal  @default(0) @db.Decimal(12, 2)
  deductionsTotal      Decimal  @default(0) @db.Decimal(12, 2)
  adjustmentsTotal     Decimal  @default(0) @db.Decimal(12, 2)
  netPay               Decimal  @db.Decimal(12, 2)
  attendancePresentDays Int     @default(0)
  attendanceAbsentDays Int      @default(0)
  workingDays          Int      @default(0)
  breakdown            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([userId])
}

// --- Phase 6: Fee payments ---

model FeePayment {
  id           String    @id @default(cuid())
  invoiceId    String
  branchId     String
  receiptNo    String?
  amount       Decimal   @db.Decimal(12, 2)
  method       String
  provider     String    @default("manual")
  providerRef  String?
  status       String    @default("pending")
  paidAt       DateTime?
  recordedById String?
  meta         Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([branchId, receiptNo])
  @@index([invoiceId])
  @@index([branchId, status])
  @@index([providerRef])
}

// --- Phase 6: Accounting ---

model Account {
  id        String    @id @default(cuid())
  branchId  String?
  code      String
  name      String
  type      String
  isSystem  Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@unique([code, branchId])
  @@index([type, isActive])
  @@index([branchId, deletedAt])
}

model JournalVoucher {
  id          String    @id @default(cuid())
  branchId    String
  voucherType String
  voucherNo   String
  voucherDate DateTime  @db.Date
  narration   String?
  status      String    @default("draft")
  sourceType  String?
  sourceId    String?
  feeTypeId   String?
  postedAt    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines    JournalLine[]
  feeType  FeeType?      @relation(fields: [feeTypeId], references: [id])

  @@unique([branchId, voucherNo])
  @@index([branchId, voucherDate])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([feeTypeId])
}

model JournalLine {
  id        String  @id @default(cuid())
  voucherId String
  accountId String
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  voucher JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id])

  @@index([voucherId])
  @@index([accountId])
}

model Budget {
  id        String   @id @default(cuid())
  branchId  String?
  year      Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BudgetLine[]

  @@index([branchId, year])
}

model BudgetLine {
  id        String  @id @default(cuid())
  budgetId  String
  accountId String
  amount    Decimal @db.Decimal(14, 2)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@index([accountId])
}

// --- Phase 7: Biometric attendance readiness ---

model BiometricDevice {
  id         String    @id @default(cuid())
  branchId   String
  name       String
  vendor     String    @default("generic")
  deviceCode String    @unique
  location   String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  externalIds BiometricExternalId[]
  punchLogs   BiometricPunchLog[]

  @@index([branchId, deletedAt])
  @@index([branchId, isActive])
}

model BiometricExternalId {
  id               String   @id @default(cuid())
  branchId         String
  deviceId         String?
  externalPersonId String
  entityType       String
  entityId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([branchId, externalPersonId])
  @@index([deviceId])
  @@index([entityType, entityId])
}

model BiometricPunchLog {
  id                 String   @id @default(cuid())
  deviceId           String
  externalPersonId   String
  punchedAt          DateTime
  payload            Json?
  matched            Boolean  @default(false)
  attendanceRecordId String?
  createdAt          DateTime @default(now())

  device BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, punchedAt])
  @@index([externalPersonId])
}

// --- Phase 7: Push token readiness ---

model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  platform  String   @default("android")
  token     String   @unique
  appRole   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appRole])
}
