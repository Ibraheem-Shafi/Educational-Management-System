{
  "name": "eims",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run db:generate -w @eims/database",
    "db:push": "npm run db:push -w @eims/database",
    "db:migrate": "npm run db:migrate -w @eims/database",
    "db:seed": "npm run db:seed -w @eims/database",
    "db:seed:demo": "npm run db:seed:demo -w @eims/database",
    "db:seed:auth": "npm run db:seed:auth -w @eims/database",
    "db:seed:all": "npm run db:seed:all -w @eims/database",
    "db:seed:verify": "npm run db:seed:verify -w @eims/database",
    "verify:app": "node scripts/verify-app-readiness.mjs",
    "mobile:parent": "npm run start:parent -w @eims/mobile",
    "mobile:student": "npm run start:student -w @eims/mobile"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.2"
}
