# Copy to apps/api/.env
# DATABASE_URL = Supabase pooler (port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = Prisma db push/seed — session pooler (port 5432). Fallback: db.[project-ref].supabase.co:5432
DIRECT_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Prisma seed scripts load this file automatically via dotenv-cli in packages/database

# Supabase (Auth + storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional: enables local HS256 JWT verify (legacy Supabase projects).
# Newer projects use ES256 — verified automatically via JWKS; keep secret as fallback only.
SUPABASE_JWT_SECRET="your-jwt-secret"

# Institution branding (seed + runtime)
INSTITUTION_NAME="Nexium Academy Pakistan"
INSTITUTION_TYPE="coaching"
INSTITUTION_TIMEZONE="Asia/Karachi"

# App URLs (CORS + invite links + email templates)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEB_URL="http://localhost:3000"

PORT=3001
NODE_ENV=development

# Set to 1 to skip admin MFA checks during local demos (see docs/demo-seed.md)
SKIP_ADMIN_MFA="1"

# Email — Nodemailer SMTP (invitations, notices)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Nexium Academy <noreply@yourdomain.com>"

# SMS / WhatsApp — Twilio (optional; supplied by the institution, not Nexium)
# Live WhatsApp needs a school WhatsApp Business number and Meta-approved Content SIDs.
# Until set, event alerts (notice / absence / fee / results) are logged only; the portal still works.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID_NOTICE=""
TWILIO_WHATSAPP_CONTENT_SID_FEE=""
TWILIO_WHATSAPP_CONTENT_SID_ABSENCE=""
TWILIO_WHATSAPP_CONTENT_SID_RESULT=""
TWILIO_WHATSAPP_CONTENT_SID_CUSTOM=""
# Public URL Twilio will POST delivery receipts to
TWILIO_STATUS_CALLBACK_URL="http://localhost:3001/api/v1/webhooks/twilio/status"

# AI — OpenAI (optional)
OPENAI_API_KEY=""
