{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ROLE": "parent"
      }
    },
    "development-student": {
      "extends": "development",
      "env": {
        "APP_ROLE": "student"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ROLE": "parent"
      }
    },
    "preview-student": {
      "extends": "preview",
      "env": {
        "APP_ROLE": "student"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ROLE": "parent"
      }
    },
    "production-student": {
      "extends": "production",
      "env": {
        "APP_ROLE": "student"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
